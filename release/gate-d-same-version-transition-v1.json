{
  "SPDX-License-Identifier": "MIT",
  "schemaVersion": 1,
  "kind": "gate-d-same-version-transition-contract",
  "sequence": ["preflight", "remove-product", "verify-absent", "install-qualification", "verify-qualified", "commit"],
  "rollback": {
    "remove-product-failed": ["recover-removal"],
    "remove-product-complete": ["restore-product"],
    "install-qualification-failed": ["recover-qualification", "restore-product"],
    "install-qualification-complete": ["remove-qualification", "restore-product"],
    "verify-qualified": ["remove-qualification", "restore-product"],
    "commit": ["remove-qualification", "restore-product"]
  },
  "requirements": [
    "ledger-bound exact-version removal only",
    "absence proof before qualification installation",
    "product-only rollback to byte-identical prestate",
    "authorization fields false in generated controls",
    "output-disabled state at every checkpoint"
  ],
  "claimCeiling": "offline orchestration primitive only; no target execution authority"
}
