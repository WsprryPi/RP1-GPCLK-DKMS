{
  "SPDX-License-Identifier": "MIT",
  "schemaVersion": 1,
  "policyId": "phase5-calibrated-review-release-v1",
  "packagingClaimCeiling": "Experimental",
  "packagingMayProduceExperimentalPrerelease": true,
  "experimentalPrereleaseRequires": [
    "applicable-packaging-gates",
    "applicable-representative-lifecycle-gates",
    "release-integrity-and-adversarial-review",
    "truthful-receiver-relative-evidence-scope",
    "current-administrator-enrollment",
    "explicit-gate-f-publication-authority"
  ],
  "packagingNeverCreatesOrPreservesQualified": true,
  "calibratedReviewCandidateBinding": [
    "source-commit",
    "archive-name-and-sha256",
    "uapi-abi-and-header-sha256",
    "gpio4-source-and-dtbo-sha256",
    "gpio20-source-and-dtbo-sha256",
    "compatibility-manifest-sha256",
    "package-and-tool-identities",
    "expected-tag"
  ],
  "finalReleaseRequiresNewReviewedManifest": true,
  "experimentalPrereleaseImmutable": true,
  "finalQualifiedRequiresCompleteCalibratedEvidence": true,
  "independentQualificationRows": {
    "routes": ["GPIO4", "GPIO20"],
    "modeFamilies": ["QRSS/TONE", "FSKCW", "DFCW", "WSPR"]
  },
  "incompleteOrFailedRowsRetainTruthfulLesserState": true,
  "changeInvalidation": {
    "newCandidateIdentityRequired": true,
    "affectedPhase5EvidenceInvalidated": true,
    "affectedLifecycleTestsRepeated": true,
    "finalManifestReviewedAgain": true,
    "domains": [
      "module-behavior-or-source",
      "overlays",
      "uapi",
      "timing",
      "package-contents-or-generated-bytes",
      "signing",
      "compatibility-policy",
      "lifecycle-tooling"
    ]
  },
  "currentSnapshot": {
    "phase5PackagingPolicyOnly": true,
    "experimentalPrereleasePublished": false,
    "calibratedReviewPerformed": false,
    "finalManifestReviewed": false,
    "finalQualifiedReleasePublished": false
  }
}
