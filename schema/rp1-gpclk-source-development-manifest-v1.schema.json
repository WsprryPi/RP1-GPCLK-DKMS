{
  "SPDX-License-Identifier": "MIT",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wsprrypi.github.io/RP1-GPCLK-DKMS/schema/rp1-gpclk-source-development-manifest-v1.schema.json",
  "title": "RP1 GPCLK exact-source development manifest v1",
  "type": "object",
  "required": ["schema", "classification", "qualification", "sourceCommit", "sourceState", "renderedVersion", "dkmsName", "moduleName", "rawInventory", "renderedInventory", "transformations", "releaseQualified"],
  "properties": {
    "schema": {"const": "rp1-gpclk-source-development-manifest-v1"},
    "classification": {"const": "source-development"},
    "qualification": {"const": false},
    "releaseQualified": {"const": false},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sourceState": {"enum": ["clean", "dirty-explicitly-allowed"]},
    "renderedVersion": {"type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]*$"},
    "dkmsName": {"const": "rp1-gpclk-dkms"},
    "moduleName": {"const": "rp1_gpclk_dkms"},
    "route": {"enum": ["gpio4", "gpio20"]},
    "rawInventory": {"$ref": "#/$defs/inventory"},
    "renderedInventory": {"$ref": "#/$defs/inventory"},
    "transformations": {"type": "array", "items": {"type": "object", "required": ["path", "beforeSha256", "afterSha256", "operation"]}}
  },
  "$defs": {
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
