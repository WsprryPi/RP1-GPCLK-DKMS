  "type":"object","additionalProperties":false,
  "required":["SPDX-License-Identifier","schemaVersion","kind","host","boot","kernel","signingPolicy","packagePaths","packagePathsSha256","administratorLedger","terminalRecovery","runtime","services","physicalSafety"],
  "properties":{
    "SPDX-License-Identifier":{"const":"MIT"},"schemaVersion":{"const":1},"kind":{"const":"gate-d-live-target-snapshot"},
    "host":{"type":"object","additionalProperties":false,"required":["hostname","architecture"],"properties":{"hostname":{"type":"string","minLength":1},"architecture":{"const":"aarch64"}}},
    "boot":{"type":"object","additionalProperties":false,"required":["bootId"],"properties":{"bootId":{"type":"string","pattern":"^[0-9a-f-]{36}$"}}},
