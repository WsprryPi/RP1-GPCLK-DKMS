  "$defs":{"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},"packagePath":{"oneOf":[{"type":"object","additionalProperties":false,"required":["path","type","sha256","mode","ownerUid","groupGid"],"properties":{"path":{"type":"string","pattern":"^/"},"type":{"const":"file"},"sha256":{"$ref":"#/$defs/sha"},"mode":{"pattern":"^0[0-7]{3}$"},"ownerUid":{"type":"integer","minimum":0},"groupGid":{"type":"integer","minimum":0}}},{"type":"object","additionalProperties":false,"required":["path","type","target","mode","ownerUid","groupGid"],"properties":{"path":{"type":"string","pattern":"^/"},"type":{"const":"symlink"},"target":{"type":"string","minLength":1},"mode":{"pattern":"^0[0-7]{3}$"},"ownerUid":{"type":"integer","minimum":0},"groupGid":{"type":"integer","minimum":0}}}]}}
