    "signingPolicy":{"type":"object","additionalProperties":false,"required":["source","enforced","sysctl","commandLineEnforced","lockdown"],"properties":{"source":{"const":"config-disabled-sysctl-absent"},"enforced":{"const":false},"sysctl":{"type":"null"},"commandLineEnforced":{"const":false},"lockdown":{"type":["string","null"]}}},
    "packagePaths":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/packagePath"}},"packagePathsSha256":{"$ref":"#/$defs/sha"},
    "administratorLedger":{"type":"object","additionalProperties":false,"required":["path","sha256","ownerUid","groupGid","mode","status","release","checkpoint","recoveryRequired","liveOutput"],"properties":{"path":{"const":"/var/lib/rp1-gpclk-dkms/transaction.json"},"sha256":{"$ref":"#/$defs/sha"},"ownerUid":{"type":"integer","minimum":0},"groupGid":{"type":"integer","minimum":0},"mode":{"const":"0600"},"status":{"type":"string","minLength":1},"release":{"type":"string","minLength":1},"checkpoint":{"type":"string","minLength":1},"recoveryRequired":{"const":false},"liveOutput":{"const":false}}},
    "terminalRecovery":{"type":"object","additionalProperties":false,"required":["path","sha256","ownerUid","groupGid","mode","status","recoveryRequired","liveOutput"],"properties":{"path":{"type":"string","pattern":"^/"},"sha256":{"$ref":"#/$defs/sha"},"ownerUid":{"type":"integer","minimum":0},"groupGid":{"type":"integer","minimum":0},"mode":{"pattern":"^0[0-7]{3}$"},"status":{"const":"complete"},"recoveryRequired":{"const":false},"liveOutput":{"const":false}}},
    "runtime":{"type":"object","additionalProperties":false,"required":["moduleLoaded","endpointPresent","overlayActive","dkmsTestVersions","liveOutput"],"properties":{"moduleLoaded":{"const":false},"endpointPresent":{"const":false},"overlayActive":{"const":false},"dkmsTestVersions":{"const":false},"liveOutput":{"const":false}}},
