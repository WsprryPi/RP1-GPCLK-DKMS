{
  "SPDX-License-Identifier": "MIT",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WsprryPi/RP1-GPCLK-DKMS/schema/rp1-gpclk-route-manager-v1.schema.json",
  "title": "RP1 GPCLK route manager request or response v1",
  "oneOf": [
    {"$ref": "#/$defs/queryRequest"}, {"$ref": "#/$defs/preflightRequest"},
    {"$ref": "#/$defs/applyRequest"}, {"$ref": "#/$defs/rollbackRequest"},
    {"$ref": "#/$defs/reconcileRequest"}, {"$ref": "#/$defs/response"}
  ],
  "$defs": {
    "route": {"enum": ["gpio4", "gpio20"]},
    "requestId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$"},
    "actor": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,127}$"},
    "queryRequest": {
      "type": "object", "properties": {"schemaVersion": {"const": 1}, "operation": {"const": "query"}},
      "required": ["schemaVersion", "operation"], "additionalProperties": false
    },
    "preflightRequest": {
      "type": "object", "properties": {"schemaVersion": {"const": 1}, "operation": {"const": "preflight"}, "route": {"$ref": "#/$defs/route"}},
      "required": ["schemaVersion", "operation", "route"], "additionalProperties": false
    },
    "applyRequest": {
      "type": "object", "properties": {"schemaVersion": {"const": 1}, "operation": {"const": "apply-and-reboot"}, "route": {"$ref": "#/$defs/route"}, "execute": {"const": true}, "requestId": {"$ref": "#/$defs/requestId"}, "actor": {"$ref": "#/$defs/actor"}},
      "required": ["schemaVersion", "operation", "route", "execute", "requestId", "actor"], "additionalProperties": false
    },
    "rollbackRequest": {
      "type": "object", "properties": {"schemaVersion": {"const": 1}, "operation": {"const": "rollback"}, "execute": {"const": true}, "requestId": {"$ref": "#/$defs/requestId"}, "actor": {"$ref": "#/$defs/actor"}},
      "required": ["schemaVersion", "operation", "execute", "requestId", "actor"], "additionalProperties": false
    },
    "reconcileRequest": {
      "type": "object", "properties": {"schemaVersion": {"const": 1}, "operation": {"const": "reconcile"}, "execute": {"const": true}, "requestId": {"$ref": "#/$defs/requestId"}, "actor": {"$ref": "#/$defs/actor"}},
      "required": ["schemaVersion", "operation", "execute", "requestId", "actor"], "additionalProperties": false
    },
    "response": {
      "type": "object", "properties": {"schemaVersion": {"const": 1}, "contract": {"const": "rp1-gpclk-route-manager-v1"}, "operation": {"type": ["string", "null"]}, "status": {"type": "string"}, "state": {"type": "object"}, "error": {"type": "object"}},
      "required": ["schemaVersion", "contract", "operation", "status"],
      "oneOf": [{"required": ["state"]}, {"required": ["error"]}], "additionalProperties": false
    }
  }
}
