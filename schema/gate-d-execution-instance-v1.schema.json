{
  "SPDX-License-Identifier": "MIT",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wsprrypi.org/schemas/gate-d-execution-instance-v1.schema.json",
  "title": "RP1 GPCLK Gate D representative-system execution instance",
  "type": "object",
  "additionalProperties": false,
  "required": ["SPDX-License-Identifier", "schemaVersion", "kind", "matrixRelease", "executionPolicy", "candidate", "authorization", "systems", "recovery", "rows", "inputsReady", "executionReady"],
  "properties": {
    "SPDX-License-Identifier": {"const": "MIT"},
    "schemaVersion": {"enum": [1, 2, 3, 4]},
    "qualificationRoot": {"$ref": "gate-d-qualification-root-v1.schema.json"},
    "kind": {"const": "gate-d-representative-system-execution-instance"},
    "matrixRelease": {"type": "string", "minLength": 1},
    "executionPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["matrixPolicy", "matrixPolicySha256", "routeDecision", "routeDecisionSha256", "targetPlan", "targetPlanSha256", "attemptIndex", "attemptIndexSha256", "environmentalCoverageComplete"],
      "properties": {
        "matrixPolicy": {"type": "string", "minLength": 1},
        "matrixPolicySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "routeDecision": {"type": "string", "minLength": 1},
        "routeDecisionSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "targetPlan": {"type": "string", "minLength": 1},
        "targetPlanSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "attemptIndex": {"type": "string", "minLength": 1},
        "attemptIndexSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "qualificationBootstrap": {"type": "string", "minLength": 1},
        "qualificationBootstrapSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "environmentalCoverageComplete": {"type": "boolean"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "sourceCommit", "release", "archiveSha256", "uapiSha256", "manifestSha256", "gpio4DtboSha256", "gpio20DtboSha256"],
      "properties": {
        "status": {"enum": ["unfrozen", "frozen"]},
        "sourceCommit": {"type": ["string", "null"]},
        "release": {"type": ["string", "null"]},
        "archiveSha256": {"type": ["string", "null"]},
        "uapiSha256": {"type": ["string", "null"]},
        "manifestSha256": {"type": ["string", "null"]},
        "gpio4DtboSha256": {"type": ["string", "null"]},
        "gpio20DtboSha256": {"type": ["string", "null"]}
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["approved", "targetExecutionApproved", "approvalScope", "administrator", "connection", "serviceChanges", "packagePrerequisites", "dkms", "moduleAdministration", "overlayAdministration", "kernelSwitching", "reboot", "failureInjection", "cleanup", "prohibitions"],
      "properties": {
        "approved": {"const": true},
        "targetExecutionApproved": {"type": "boolean"},
        "approvalScope": {"type": "string", "minLength": 1},
        "administrator": {"type": "string", "minLength": 1},
        "connection": {"type": "string", "minLength": 1},
        "serviceChanges": {"type": "string", "minLength": 1},
        "packagePrerequisites": {"type": "string", "minLength": 1},
        "dkms": {"type": "string", "minLength": 1},
        "moduleAdministration": {"type": "string", "minLength": 1},
        "overlayAdministration": {"type": "string", "minLength": 1},
        "kernelSwitching": {"type": "string", "minLength": 1},
        "reboot": {"type": "string", "minLength": 1},
        "failureInjection": {"type": "string", "minLength": 1},
        "cleanup": {"type": "string", "minLength": 1},
        "prohibitions": {"type": "array", "minItems": 14, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "systems": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "host", "model", "revision", "architecture", "os", "kernels", "signingEnforced", "headers", "compiler", "routes", "stableIdentifier"],
        "properties": {
          "id": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1},
          "host": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1}, "architecture": {"const": "aarch64"},
          "os": {"type": "string", "minLength": 1},
          "kernels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "signingEnforced": {"type": "boolean"},
          "headers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "compiler": {"type": "string", "minLength": 1},
          "routes": {"type": "array", "uniqueItems": true, "items": {"enum": ["gpio4", "gpio20"]}},
          "stableIdentifier": {"type": "string", "minLength": 1}
        }
      }
    },
    "recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["rescueHost", "bootOrder", "rootSource", "bootSource", "nvmeVisibleUnmounted", "sshReturnSeconds", "automaticRecoverySeconds", "assistanceSeconds", "validated"],
      "properties": {
        "rescueHost": {"type": "string", "minLength": 1}, "bootOrder": {"type": "string", "minLength": 1},
        "rootSource": {"type": "string", "minLength": 1}, "bootSource": {"type": "string", "minLength": 1},
        "nvmeVisibleUnmounted": {"const": true}, "validated": {"const": true},
        "sshReturnSeconds": {"type": "integer", "minimum": 1, "maximum": 1800},
        "automaticRecoverySeconds": {"type": "integer", "minimum": 1, "maximum": 1800},
        "assistanceSeconds": {"type": "integer", "minimum": 1, "maximum": 1800}
      }
    },
    "rows": {
      "type": "array", "minItems": 15, "maxItems": 15,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "systemId", "kernel", "routes", "deadlineSeconds", "evidenceDirectory", "failureInjection", "expectedFinalState", "blockers"],
        "properties": {
          "id": {"type": "string", "minLength": 1}, "status": {"enum": ["ready", "blocked-input-required", "deferred-environmental"]},
          "systemId": {"type": ["string", "null"]}, "kernel": {"type": ["string", "null"]},
          "routes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["gpio4", "gpio20", "route-neutral"]}},
          "deadlineSeconds": {"type": "integer", "minimum": 1, "maximum": 1800},
          "evidenceDirectory": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+/-]*$"},
          "failureInjection": {"type": "string", "minLength": 1},
          "expectedFinalState": {"type": "string", "minLength": 1},
          "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "inputsReady": {"type": "boolean"},
    "executionReady": {"type": "boolean"}
  },
  "allOf": [
    {"if": {"properties": {"schemaVersion": {"const": 1}}, "required": ["schemaVersion"]}, "then": {"properties": {"executionPolicy": {"not": {"anyOf": [{"required": ["qualificationBootstrap"]}, {"required": ["qualificationBootstrapSha256"]}]}}}, "not": {"required": ["qualificationRoot"]}}},
    {"if": {"properties": {"schemaVersion": {"const": 2}}, "required": ["schemaVersion"]}, "then": {"properties": {"executionPolicy": {"required": ["qualificationBootstrap", "qualificationBootstrapSha256"]}}, "not": {"required": ["qualificationRoot"]}}},
    {"if": {"properties": {"schemaVersion": {"enum": [3, 4]}}, "required": ["schemaVersion"]}, "then": {"required": ["qualificationRoot"], "properties": {"executionPolicy": {"required": ["qualificationBootstrap", "qualificationBootstrapSha256"]}}}}
  ]
}
