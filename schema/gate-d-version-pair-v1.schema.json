{
  "SPDX-License-Identifier": "MIT",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wsprrypi.example/schema/gate-d-version-pair-v1.schema.json",
  "title": "Gate D predecessor and successor pair",
  "type": "object",
  "additionalProperties": false,
  "required": ["SPDX-License-Identifier", "schemaVersion", "kind", "predecessor", "successor", "transition"],
  "properties": {
    "SPDX-License-Identifier": {"const": "MIT"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "gate-d-version-pair"},
    "predecessor": {"$ref": "#/$defs/release"},
    "successor": {"$ref": "#/$defs/release"},
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["upgrade", "downgrade", "rollback", "interruption", "outputEnabled"],
      "properties": {
        "upgrade": {"const": "predecessor-to-successor"},
        "downgrade": {"const": "successor-to-predecessor"},
        "rollback": {"const": "failed-successor-to-exact-predecessor"},
        "interruption": {"const": "exactly-one-complete-inactive-version"},
        "outputEnabled": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "sourceCommit", "archive", "archiveSha256", "uapiSha256", "manifestSha256", "gpio4DtboSha256", "gpio20DtboSha256", "restorableComplete", "evidence"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-[0-9A-Za-z][0-9A-Za-z.-]*$"},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "archive": {"type": "string", "pattern": "^rp1-gpclk-dkms-[0-9A-Za-z.+-]+\\.tar\\.gz$"},
        "archiveSha256": {"$ref": "#/$defs/sha256"},
        "uapiSha256": {"$ref": "#/$defs/sha256"},
        "manifestSha256": {"$ref": "#/$defs/sha256"},
        "gpio4DtboSha256": {"$ref": "#/$defs/sha256"},
        "gpio20DtboSha256": {"$ref": "#/$defs/sha256"},
        "restorableComplete": {"type": "boolean"},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
