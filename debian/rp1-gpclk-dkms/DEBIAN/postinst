#!/bin/sh
# SPDX-License-Identifier: MIT

set -e

# Automatically added by dh_dkms/3.2.2-1~deb13u1
DKMS_NAME=rp1-gpclk-dkms
DKMS_PACKAGE_NAME=$DKMS_NAME-dkms
DKMS_VERSION=1.1.0

postinst_found=0

case "$1" in
	configure)
		for DKMS_POSTINST in /usr/lib/dkms/common.postinst /usr/share/$DKMS_PACKAGE_NAME/postinst; do
			if [ -f $DKMS_POSTINST ]; then
				$DKMS_POSTINST $DKMS_NAME $DKMS_VERSION /usr/share/$DKMS_PACKAGE_NAME "" $2
				postinst_found=1
				break
			fi
		done
		if [ "$postinst_found" -eq 0 ]; then
			echo "ERROR: DKMS version is too old and $DKMS_PACKAGE_NAME was not"
			echo "built with legacy DKMS support."
			echo "You must either rebuild $DKMS_PACKAGE_NAME with legacy postinst"
			echo "support or upgrade DKMS to a more current version."
			exit 1
		fi
	;;
esac
# End automatically added section


if [ "$1" = configure ]; then
    source_dir=/usr/lib/rp1-gpclk-dkms/overlays
    target_dir=/boot/firmware/overlays
    mkdir -p "$target_dir"

    for name in rp1-gpclk-gpio4.dtbo rp1-gpclk-gpio20.dtbo; do
        source_file="$source_dir/$name"
        target_file="$target_dir/$name"
        temporary_file="$target_file.rp1-gpclk-dkms-new"

        if [ -e "$target_file" ] && ! cmp -s "$source_file" "$target_file"; then
            echo "rp1-gpclk-dkms: refusing to replace unrecognized $target_file" >&2
            exit 1
        fi

        trap 'rm -f "$temporary_file"' EXIT HUP INT TERM
        install -m 0644 "$source_file" "$temporary_file"
        mv -f "$temporary_file" "$target_file"
        trap - EXIT HUP INT TERM
    done
fi

exit 0
