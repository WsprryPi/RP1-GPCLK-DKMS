#!/usr/bin/make -f
# SPDX-License-Identifier: MIT

PACKAGE := rp1-gpclk-dkms
MODULE_VERSION := 0.9.0
SOURCE_DEST := debian/$(PACKAGE)/usr/src/$(PACKAGE)-$(MODULE_VERSION)
OVERLAY_DEST := debian/$(PACKAGE)/usr/lib/$(PACKAGE)/overlays
EXEC_DEST := debian/$(PACKAGE)/usr/libexec/$(PACKAGE)
SCHEMA_DEST := debian/$(PACKAGE)/usr/share/$(PACKAGE)/$(MODULE_VERSION)
DOC_DEST := debian/$(PACKAGE)/usr/share/doc/$(PACKAGE)
UNIT_DEST := debian/$(PACKAGE)/usr/lib/systemd/system

%:
	dh $@ --with dkms

override_dh_auto_build:
	mkdir -p debian/build
	python3 -c 'import pathlib; from scripts.build_release import build_dtbo; root=pathlib.Path("."); [build_dtbo(root / "overlays" / (name + ".dts"), root / "debian" / "build" / (name + ".dtbo"), "dtc") for name in ("rp1-gpclk-gpio4", "rp1-gpclk-gpio20")]'

override_dh_auto_test:
	python3 tests/check_debian_packaging.py

override_dh_auto_install:
	mkdir -p $(SOURCE_DEST)/src $(SOURCE_DEST)/include/rp1_gpclk $(SOURCE_DEST)/include/uapi/linux $(SOURCE_DEST)/overlays
	cp Kbuild Makefile $(SOURCE_DEST)/
	cp src/*.c $(SOURCE_DEST)/src/
	cp include/rp1_gpclk/*.h $(SOURCE_DEST)/include/rp1_gpclk/
	cp include/uapi/linux/rp1_gpclk.h $(SOURCE_DEST)/include/uapi/linux/
	cp overlays/rp1-gpclk-gpio4.dts overlays/rp1-gpclk-gpio20.dts $(SOURCE_DEST)/overlays/
	mkdir -p $(OVERLAY_DEST)
	cp debian/build/rp1-gpclk-gpio4.dtbo debian/build/rp1-gpclk-gpio20.dtbo $(OVERLAY_DEST)/
	mkdir -p $(EXEC_DEST) debian/$(PACKAGE)/usr/sbin $(SCHEMA_DEST) $(DOC_DEST) $(UNIT_DEST)
	install -m 0755 scripts/rp1-gpclk-route-manager.py $(EXEC_DEST)/rp1-gpclk-route-manager
	install -m 0755 scripts/rp1-gpclk-route-manager.py debian/$(PACKAGE)/usr/sbin/rp1-gpclk-route-manager
	install -m 0644 schema/rp1-gpclk-route-manager-v1.schema.json $(SCHEMA_DEST)/
	install -m 0644 docs/contracts/route-manager-v1.md $(DOC_DEST)/route-manager-v1.md
	install -m 0644 systemd/rp1-gpclk-route-manager.socket systemd/rp1-gpclk-route-manager@.service $(UNIT_DEST)/

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start rp1-gpclk-route-manager.socket

override_dh_compress:
	dh_compress -Xroute-manager-v1.md

override_dh_dkms:
	dh_dkms -V $(MODULE_VERSION)

override_dh_auto_clean:
	rm -rf debian/build
