#!/bin/sh
# SPDX-License-Identifier: MIT

set -e

#DEBHELPER#

if [ "$1" = configure ]; then
    if ! getent group rp1-gpclk-route >/dev/null; then
        addgroup --system rp1-gpclk-route
    fi
    install -d -o root -g root -m 0755 /var/lib/rp1-gpclk-dkms
    source_dir=/usr/lib/rp1-gpclk-dkms/overlays
    target_dir=/boot/firmware/overlays
    mkdir -p "$target_dir"

    for name in rp1-gpclk-gpio4.dtbo rp1-gpclk-gpio20.dtbo; do
        source_file="$source_dir/$name"
        target_file="$target_dir/$name"
        temporary_file="$target_file.rp1-gpclk-dkms-new"

        if [ -e "$target_file" ] && ! cmp -s "$source_file" "$target_file"; then
            echo "rp1-gpclk-dkms: refusing to replace unrecognized $target_file" >&2
            exit 1
        fi

        trap 'rm -f "$temporary_file"' EXIT HUP INT TERM
        install -m 0644 "$source_file" "$temporary_file"
        mv -f "$temporary_file" "$target_file"
        trap - EXIT HUP INT TERM
    done
fi

exit 0
