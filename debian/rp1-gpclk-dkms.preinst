#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu

# dpkg permits explicit downgrades. This development baseline requires removal
# through an independently reviewed recovery plan before a clean installation.
case "${1:-}" in
install|upgrade)
    if [ -n "${2:-}" ] && dpkg --compare-versions "$2" gt 0.9.0-1; then
        echo 'rp1-gpclk-dkms: 1.x to 0.9.0 is a downgrade; explicit maintainer migration and predecessor removal required' >&2
        exit 1
    fi
    ;;
esac

#DEBHELPER#
exit 0
